{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Game",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/checkers.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb", 
            "preLaunchTask": "Run Makefile Build", // 👈 This links to your task above!
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}